PORT=5000
NODE_ENV=development

# Database - Choose one (MongoDB or MySQL)
DB_TYPE=mongodb

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ttms
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ttms

# MySQL (alternative)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=ttms

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_please_make_it_long_and_random
JWT_EXPIRE=7d

# CORS
CLIENT_URL=http://localhost:3000

# API
API_VERSION=v1
API_PREFIX=/api/v1

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
